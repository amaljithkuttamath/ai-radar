__pycache__/
*.pyc
.env
.venv/
# Corpus is regenerable; keep folders, not contents.
data/raw/*
data/scored/*
data/enriched/*
!**/.gitkeep

# The CI job commits the digest and the dedup ledger so runs build on each other.
# Track those two; ignore everything else under data/ and reports/.
reports/*
!reports/*.md
!data/seen.json
!data/state.json
# The carryover ledger: which items the radar is still watching, and their traction history.
!data/tracked.json

# local harness artifact
.claude/scheduled_tasks.lock

# Replay inputs and experiment evidence are local; CI retains cases as artifacts.
data/evolution/

# Runtime health, previews, and offline examples.
data/collection.json
data/previews/
data/demo/
data/embed_cache/
data/.pipeline.lock
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Browser reader development dependencies.
site/node_modules/
